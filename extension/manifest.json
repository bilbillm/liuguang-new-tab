{
  "manifest_version": 3,
  "name": "流光新标签页",
  "description": "在 Microsoft Edge 新标签页中浏览本地壁纸、搜索网页并打开常用网站。",
  "version": "0.1.14",
  "minimum_chrome_version": "120",
  "key": "",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "nativeMessaging"],
  "background": { "service_worker": "background.js" }
}
